{
  "name": "anyam",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/create-anyam", "apps/realm-worker", "apps/github-mirror-producer", "apps/public-gateway-worker", "apps/hosted-saas-qualification", "apps/promotion-executor", "apps/linux-egress-qualification", "apps/repository-observer", "apps/repository-driver", "apps/site", "examples/worker-app", "examples/typescript-cli", "examples/hybrid-video-player"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\" test/artifacts-realm-runtime.test.mjs test/authority-disclosure-runtime.test.mjs",
    "harness": "tsx src/harness/cli.ts",
    "qualification:external-runner": "tsx scripts/qualify-external-runner.ts",
    "qualification:provider-feed": "tsx scripts/qualify-provider-feed.ts",
    "qualification:worker-target": "tsx scripts/qualify-worker-target.ts",
    "qualification:authority-sqlite": "tsx scripts/qualify-authority-sqlite.ts",
    "qualification:cohort-local-verifier": "tsx scripts/qualify-cohort-local-verifier.ts",
    "qualification:repository-observer": "tsx scripts/qualify-repository-observer.ts",
    "qualification:worker-test-boundary": "node scripts/qualify-worker-test-boundary.mjs",
    "qualification:real-team-gate": "tsx scripts/qualify-real-team-gate.ts",
    "qualification:cloudflare-golden-path": "tsx scripts/qualify-cloudflare-golden-path.ts",
    "qualification:cloudflare-golden-recovery": "tsx scripts/qualify-cloudflare-golden-recovery.ts",
    "qualification:team-simulation": "tsx scripts/qualify-team-simulation.ts",
    "qualification:linux-egress": "tsx scripts/qualify-linux-egress.ts",
    "qualification:linux-workspace": "tsx scripts/qualify-linux-workspace.ts",
    "qualification:promotion-executor": "tsx scripts/qualify-promotion-executor.ts",
    "qualification:promotion-reconciliation": "tsx scripts/qualify-promotion-reconciliation.ts",
    "realm:installation-manifest": "tsx scripts/realm-installation-manifest.ts",
    "qualification:mcp-delivery-mutations": "tsx scripts/qualify-mcp-delivery-mutations.ts",
    "qualification:private-alpha-journey": "tsx scripts/qualify-private-alpha-journey.ts",
    "test:private-alpha-journey": "tsx --test test/private-alpha-journey.test.ts",
    "qualification:replay-archive-workload": "tsx scripts/qualify-replay-archive-workload.ts",
    "qualification:hosted-saas": "tsx scripts/qualify-hosted-saas.ts",
    "qualification:github-app": "tsx scripts/qualify-github-app.ts",
    "qualification:github-release-assets": "tsx scripts/qualify-github-release-assets.ts",
    "qualification:agent-scale-workspaces": "tsx scripts/qualify-agent-scale-workspaces.ts",
    "check:ci-hygiene": "node scripts/validate-ci-hygiene.mjs",
    "check:dependencies": "npm audit --audit-level=high",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:qualification-worker": "tsc -p apps/runner-qualification/tsconfig.json --noEmit",
    "typecheck:worker-tests": "tsc -p tsconfig.worker-tests.json --noEmit",
    "typecheck:provider-target": "tsc -p apps/provider-qualification-target/tsconfig.json --noEmit",
    "typecheck:hosted-saas": "tsc -p apps/hosted-saas-qualification/tsconfig.json --noEmit",
    "typecheck:promotion-executor": "tsc -p apps/promotion-executor/tsconfig.json --noEmit",
    "typecheck:linux-egress": "tsc -p apps/linux-egress-qualification/tsconfig.json --noEmit",
    "typecheck:repository-observer": "tsc -p apps/repository-observer/tsconfig.json --noEmit",
    "typecheck:repository-driver": "tsc -p apps/repository-driver/tsconfig.json --noEmit",
    "typecheck:github-mirror-producer": "tsc -p apps/github-mirror-producer/tsconfig.json --noEmit",
    "typecheck:repository-driver-qualification": "tsc -p tsconfig.repository-driver-qualification.json --noEmit",
    "typecheck:repository-observer-qualification": "tsc -p tsconfig.repository-observer-qualification.json --noEmit",
    "build:qualification-worker": "npm run typecheck:qualification-worker && wrangler deploy --dry-run --config apps/runner-qualification/wrangler.qualification.jsonc --outdir=dist/qualification-worker",
    "build:hosted-saas": "npm run typecheck:hosted-saas && wrangler deploy --dry-run --config apps/hosted-saas-qualification/wrangler.example.jsonc --outdir=dist/hosted-saas-qualification",
    "build:public-gateway": "npm run build --workspace=@anyam/public-gateway-worker",
    "build:replay-archive-workload": "npm run typecheck:replay-archive-workload && wrangler deploy --dry-run --config apps/replay-archive-workload-qualification/wrangler.jsonc --outdir=dist/replay-archive-workload-qualification",
    "build:provider-target": "npm run typecheck:provider-target && wrangler deploy --dry-run --config apps/provider-qualification-target/wrangler.jsonc --outdir=dist/provider-qualification-target",
    "build:promotion-executor": "npm run typecheck:promotion-executor && wrangler deploy --dry-run --config apps/promotion-executor/wrangler.example.jsonc --outdir=dist/promotion-executor",
    "build:linux-egress": "npm run typecheck:linux-egress && wrangler deploy --dry-run --config apps/linux-egress-qualification/wrangler.example.jsonc --outdir=dist/linux-egress-qualification",
    "build:repository-observer": "npm run typecheck:repository-observer && wrangler deploy --dry-run --config apps/repository-observer/wrangler.example.jsonc --outdir=dist/repository-observer",
    "build:repository-driver": "npm run typecheck:repository-driver && wrangler deploy --dry-run --config apps/repository-driver/wrangler.example.jsonc --outdir=dist/repository-driver",
    "build:github-mirror-producer": "npm run typecheck:github-mirror-producer && wrangler deploy --dry-run --config apps/github-mirror-producer/wrangler.example.jsonc --outdir=dist/github-mirror-producer",
    "build": "npm run build --workspace=create-anyam",
    "typecheck:site": "npm run typecheck --workspace=@anyam/site",
    "build:site": "npm run build --workspace=@anyam/site",
    "verify:docs": "node scripts/docs-smoke.mjs && npm run build && node scripts/docs-command-smoke.mjs",
    "verify:site": "npm run typecheck:site && npm run build:site && node scripts/site-smoke.mjs && wrangler deploy --dry-run --config apps/site/wrangler.example.jsonc --outdir=dist/site-worker",
    "verify:examples": "npm run build && node scripts/examples-smoke.mjs",
    "verify:package": "npm run build && node scripts/package-entrypoint-smoke.mjs",
    "verify:workers": "node scripts/worker-entrypoint-smoke.mjs",
    "build:realm": "npm run build --workspace=@anyam/realm-worker",
    "check:realm": "npm run check && npm run build:realm",
    "typecheck:replay-archive-workload": "tsc -p apps/replay-archive-workload-qualification/tsconfig.json --noEmit",
    "qualification:repository-driver": "tsx scripts/qualify-repository-driver.ts",
    "check": "npm run check:ci-hygiene && npm run check:dependencies && npm run typecheck && npm run typecheck:scripts && npm run typecheck:qualification-worker && npm run typecheck:provider-target && npm run typecheck:hosted-saas && npm run typecheck:replay-archive-workload && npm run typecheck:promotion-executor && npm run typecheck:linux-egress && npm run typecheck:repository-observer && npm run typecheck:repository-driver && npm run typecheck:artifacts-workspaces && npm run typecheck:github-mirror-producer && npm run typecheck:repository-observer-qualification && npm run typecheck:repository-driver-qualification && npm run typecheck:worker-tests && npm run typecheck:site && npm run verify:docs && npm run qualification:worker-test-boundary && npm run qualification:authority-sqlite && npm run qualification:repository-observer && npm run qualification:repository-driver && npm test && npm run verify:package && npm run verify:examples && npm run verify:site && npm run verify:workers",
    "qualification:artifacts-workspaces": "tsx --test test/artifacts-workspace.test.ts test/artifacts-workspace-custody.test.ts test/artifacts-workspace-observation.test.ts test/artifacts-workspace-qualification.test.ts test/smart-http-repository.test.ts test/smart-http-state-model.test.ts",
    "qualification:artifacts-realm-local": "tsx --test test/artifacts-realm-runtime.test.mjs",
    "qualification:disclosure-local": "tsx --test test/authority-disclosure.test.ts test/authority-disclosure-runtime.test.mjs",
    "qualification:scm-credential-model": "tsx scripts/qualify-scm-credential-model.ts",
    "typecheck:artifacts-workspaces": "tsc -p apps/artifacts-workspace-contract/tsconfig.json --noEmit",
    "build:artifacts-workspaces": "npm run typecheck:artifacts-workspaces && wrangler deploy --dry-run --config apps/artifacts-workspace-contract/wrangler.qualification.jsonc --outdir=dist/artifacts-workspace-contract"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@cloudflare/workers-types": "5.20261001.1",
    "esbuild": "0.28.1",
    "miniflare": "5.20261001.0-alpha",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "4.146.0"
  }
}
