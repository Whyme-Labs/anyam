{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "anyam-promotion-executor",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Non-secret route metadata. The named credential bindings are set with
    // `wrangler secret put` and are deliberately not represented here.
    "ANYAM_PROMOTION_TARGET_ROUTES": "[{\"targetId\":\"target:staging\",\"accountId\":\"replace-with-customer-cloudflare-account-id\",\"scriptName\":\"replace-with-staging-worker-script\",\"previewSubdomain\":\"replace-with-customer-workers-dev-subdomain\",\"credentialBinding\":\"ANYAM_PROMOTION_CLOUDFLARE_API_TOKEN_STAGING\",\"credentialScopes\":[\"workers:read\",\"workers:write\"]},{\"targetId\":\"target:production\",\"accountId\":\"replace-with-customer-cloudflare-account-id\",\"scriptName\":\"replace-with-production-worker-script\",\"previewSubdomain\":\"replace-with-customer-workers-dev-subdomain\",\"credentialBinding\":\"ANYAM_PROMOTION_CLOUDFLARE_API_TOKEN_PRODUCTION\",\"credentialScopes\":[\"workers:read\",\"workers:write\"]}]",
    "ANYAM_PROMOTION_HEALTH_RECEIPT": "replace-with-credential-free-installation-probe-receipt",
    "ANYAM_PROMOTION_HANDOFF_KEY_ID": "replace-with-customer-promotion-handoff-key-id",
    "ANYAM_PROMOTION_HANDOFF_PREVIOUS_KEY_ID": "replace-with-previous-promotion-handoff-key-id-or-omit"
  },
  "r2_buckets": [
    {
      "binding": "ANYAM_PROMOTION_ARTIFACTS",
      "bucket_name": "replace-with-customer-anyam-artifacts",
      "preview_bucket_name": "replace-with-customer-anyam-artifacts-preview"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ANYAM_PROMOTION_NONCE_STORE",
        "class_name": "PromotionExecutorNonceStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PromotionExecutorNonceStore"]
    }
  ]
}
