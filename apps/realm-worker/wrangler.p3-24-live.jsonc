{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "anyam-p3-24-live-20260810",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "account_id": "1e0170aaabc90ecf5f466128d1f0466a",
  "vars": {
    "ANYAM_HOSTING_MODE": "customer-operated",
    "ANYAM_INSTALLATION_ID": "anyam-p3-24-live-20260810",
    "ANYAM_PROTOCOL_VERSION": "anyam.customer-realm-worker/v1",
    "ANYAM_REALM_RP_ID": "anyam-p3-24-live-20260810.swmengappdev.workers.dev",
    "ANYAM_AUTHORITY_RECOVERY_KEY_ID": "authority-recovery-qualification-v1",
    "ANYAM_BUILD_REVISION": "6a0e2186e716c5cc4723186de70c84a3d0c5cb19",
    "ANYAM_PROVIDER_WORKER_URL": "https://anyam-p3-24-target-20260810.swmengappdev.workers.dev",
    "ANYAM_MIRROR_HANDOFF_KEY_ID": "mirror-handoff-v1",
    "ANYAM_MIRROR_HANDOFF_MAX_LIFETIME_MS": "300000",
    "ANYAM_MIRROR_HANDOFF_MAX_LIFETIME_RECEIPT": "qualification-tripwire; handoffMaxLifetimeMs=300000; remeasure-before-production",
    "ANYAM_MIRROR_HANDOFF_CLOCK_SKEW_MS": "30000",
    "ANYAM_MIRROR_HANDOFF_CLOCK_SKEW_RECEIPT": "qualification-tripwire; clockSkewMs=30000; remeasure-before-production",
    "ANYAM_GITHUB_APP_REPOSITORY": "replace-with-selected-github-owner/name",
    "ANYAM_GITHUB_APP_INSTALLATION_ID": "replace-with-selected-github-app-installation-id",
    "ANYAM_GITHUB_WEBHOOK_BODY_BYTES_LIMIT": "1048576",
    "ANYAM_GITHUB_WEBHOOK_BODY_BYTES_RECEIPT": "qualification-tripwire; bodyBytesLimit=1048576; remeasure-before-production",
    "ANYAM_GITHUB_WEBHOOK_RATE_LIMIT_RECEIPT": "qualification-tripwire; limit=100; period=60s; remeasure-before-production"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "339e0f96aff646468aaf6a5804a789cc"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALM_COORDINATOR",
        "class_name": "AnyamRealmCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "anyam-p3-24-live-20260810-initial",
      "new_sqlite_classes": ["AnyamRealmCoordinator"]
    }
  ],
  "services": [
    {
      "binding": "ANYAM_PROVIDER_WORKER",
      "service": "anyam-p3-24-target-20260810"
    },
    {
      "binding": "ANYAM_GITHUB_MIRROR_PRODUCER",
      "service": "anyam-github-mirror-producer-p3-24-live-20260810"
    }
  ],
  "d1_databases": [
    {
      "binding": "ANYAM_METADATA_DB",
      "database_name": "anyam-p3-24-live-20260810-metadata",
      "database_id": "9ed28760-7937-4e6a-9547-6f3784687225",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "ANYAM_EXPORTS",
      "bucket_name": "anyam-p3-24-live-20260810-exports"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ANYAM_EVENTS",
        "queue": "anyam-p3-24-live-20260810-events"
      }
    ],
    "consumers": [
      {
        "queue": "anyam-p3-24-live-20260810-events"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "ANYAM_GITHUB_WEBHOOK_RATE_LIMITER",
      "namespace_id": "replace-with-customer-rate-limit-namespace-id",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "workflows": [
    {
      "binding": "ANYAM_WORKFLOW",
      "name": "anyam-p3-24-live-20260810-workflow",
      "class_name": "AnyamRealmWorkflow"
    }
  ]
}
