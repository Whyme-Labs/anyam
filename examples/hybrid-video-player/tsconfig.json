{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist-types"
  },
  "include": ["src/**/*.ts", "public-player/**/*.ts", "private-codec/**/*.ts"]
}
