{
  "name": "anyam",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/create-anyam", "apps/realm-worker", "apps/public-gateway-worker", "apps/hosted-saas-qualification", "apps/promotion-executor"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "harness": "tsx src/harness/cli.ts",
    "qualification:external-runner": "tsx scripts/qualify-external-runner.ts",
    "qualification:provider-feed": "tsx scripts/qualify-provider-feed.ts",
    "qualification:worker-target": "tsx scripts/qualify-worker-target.ts",
    "qualification:promotion-executor": "tsx scripts/qualify-promotion-executor.ts",
    "qualification:promotion-reconciliation": "tsx scripts/qualify-promotion-reconciliation.ts",
    "qualification:mcp-delivery-mutations": "tsx scripts/qualify-mcp-delivery-mutations.ts",
    "qualification:private-alpha-journey": "tsx scripts/qualify-private-alpha-journey.ts",
    "test:private-alpha-journey": "tsx --test test/private-alpha-journey.test.ts",
    "qualification:replay-archive-workload": "tsx scripts/qualify-replay-archive-workload.ts",
    "qualification:hosted-saas": "tsx scripts/qualify-hosted-saas.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:qualification-worker": "tsc -p apps/runner-qualification/tsconfig.json --noEmit",
    "typecheck:worker-tests": "tsc -p tsconfig.worker-tests.json --noEmit",
    "typecheck:provider-target": "tsc -p apps/provider-qualification-target/tsconfig.json --noEmit",
    "typecheck:hosted-saas": "tsc -p apps/hosted-saas-qualification/tsconfig.json --noEmit",
    "typecheck:promotion-executor": "tsc -p apps/promotion-executor/tsconfig.json --noEmit",
    "build:qualification-worker": "npm run typecheck:qualification-worker && wrangler deploy --dry-run --config apps/runner-qualification/wrangler.qualification.jsonc --outdir=dist/qualification-worker",
    "build:hosted-saas": "npm run typecheck:hosted-saas && wrangler deploy --dry-run --config apps/hosted-saas-qualification/wrangler.example.jsonc --outdir=dist/hosted-saas-qualification",
    "build:public-gateway": "npm run build --workspace=@anyam/public-gateway-worker",
    "build:replay-archive-workload": "npm run typecheck:replay-archive-workload && wrangler deploy --dry-run --config apps/replay-archive-workload-qualification/wrangler.jsonc --outdir=dist/replay-archive-workload-qualification",
    "build:provider-target": "npm run typecheck:provider-target && wrangler deploy --dry-run --config apps/provider-qualification-target/wrangler.jsonc --outdir=dist/provider-qualification-target",
    "build:promotion-executor": "npm run typecheck:promotion-executor && wrangler deploy --dry-run --config apps/promotion-executor/wrangler.example.jsonc --outdir=dist/promotion-executor",
    "build": "npm run build --workspace=create-anyam",
    "verify:package": "npm run build && node scripts/package-entrypoint-smoke.mjs",
    "verify:workers": "node scripts/worker-entrypoint-smoke.mjs",
    "build:realm": "npm run build --workspace=@anyam/realm-worker",
    "check:realm": "npm run check && npm run build:realm",
    "typecheck:replay-archive-workload": "tsc -p apps/replay-archive-workload-qualification/tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run typecheck:scripts && npm run typecheck:qualification-worker && npm run typecheck:provider-target && npm run typecheck:hosted-saas && npm run typecheck:replay-archive-workload && npm run typecheck:promotion-executor && npm run typecheck:worker-tests && npm test && npm run verify:package && npm run verify:workers"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@cloudflare/workers-types": "5.20260801.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "4.118.0"
  }
}
