{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "anyam-p3-24-live-20260810",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "account_id": "1e0170aaabc90ecf5f466128d1f0466a",
  "vars": {
    "ANYAM_HOSTING_MODE": "customer-operated",
    "ANYAM_INSTALLATION_ID": "anyam-p3-24-live-20260810",
    "ANYAM_PROTOCOL_VERSION": "anyam.customer-realm-worker/v1",
    "ANYAM_REALM_RP_ID": "anyam-p3-24-live-20260810.swmengappdev.workers.dev",
    "ANYAM_BUILD_REVISION": "2d7ff99986da522e2562b9e4a8f86a94b576c145",
    "ANYAM_PROVIDER_WORKER_URL": "https://anyam-p3-24-target-20260810.swmengappdev.workers.dev"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "339e0f96aff646468aaf6a5804a789cc"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALM_COORDINATOR",
        "class_name": "AnyamRealmCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "anyam-p3-24-live-20260810-initial",
      "new_sqlite_classes": ["AnyamRealmCoordinator"]
    }
  ],
  "services": [
    {
      "binding": "ANYAM_PROVIDER_WORKER",
      "service": "anyam-p3-24-target-20260810"
    }
  ],
  "d1_databases": [
    {
      "binding": "ANYAM_METADATA_DB",
      "database_name": "anyam-p3-24-live-20260810-metadata",
      "database_id": "9ed28760-7937-4e6a-9547-6f3784687225",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "ANYAM_EXPORTS",
      "bucket_name": "anyam-p3-24-live-20260810-exports"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ANYAM_EVENTS",
        "queue": "anyam-p3-24-live-20260810-events"
      }
    ],
    "consumers": [
      {
        "queue": "anyam-p3-24-live-20260810-events"
      }
    ]
  },
  "workflows": [
    {
      "binding": "ANYAM_WORKFLOW",
      "name": "anyam-p3-24-live-20260810-workflow",
      "class_name": "AnyamRealmWorkflow"
    }
  ]
}
