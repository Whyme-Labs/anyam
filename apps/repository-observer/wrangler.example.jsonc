{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "anyam-repository-observer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "REPOSITORY_OBSERVER_REQUEST_BYTES_LIMIT": "replace-with-measured-observer-request-limit",
    "REPOSITORY_OBSERVER_REQUEST_BYTES_RECEIPT": "receipt:replace-with-observer-request-measurement"
  },
  "services": [
    {
      "binding": "REPOSITORY_DRIVER",
      "service": "replace-with-customer-repository-driver"
    }
  ]
}
