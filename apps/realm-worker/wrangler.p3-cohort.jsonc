{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "anyam-p3-cohort-20260803",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ANYAM_HOSTING_MODE": "customer-operated",
    "ANYAM_INSTALLATION_ID": "anyam-p3-cohort-20260803",
    "ANYAM_PROTOCOL_VERSION": "anyam.customer-realm-worker/v1",
    "ANYAM_BUILD_REVISION": "6e9bca5119b3e6f80f3c8085ebc5a686adb42af2",
    "ANYAM_MIRROR_HANDOFF_KEY_ID": "mirror-handoff-v1",
    "ANYAM_GITHUB_APP_REPOSITORY": "replace-with-selected-github-owner/name",
    "ANYAM_GITHUB_APP_INSTALLATION_ID": "replace-with-selected-github-app-installation-id",
    "ANYAM_GITHUB_WEBHOOK_BODY_BYTES_LIMIT": "1048576",
    "ANYAM_GITHUB_WEBHOOK_BODY_BYTES_RECEIPT": "qualification-tripwire; bodyBytesLimit=1048576; remeasure-before-production",
    "ANYAM_GITHUB_WEBHOOK_RATE_LIMIT_RECEIPT": "qualification-tripwire; limit=100; period=60s; remeasure-before-production"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REALM_COORDINATOR",
        "class_name": "AnyamRealmCoordinator"
      }
    ]
  },
  "exports": {
    "AnyamRealmCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "ANYAM_METADATA_DB",
      "database_name": "anyam-p3-cohort-20260803-metadata",
      "database_id": "ef94b85a-c8e8-424b-afaa-cd08a085a4f8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ANYAM_EXPORTS",
      "bucket_name": "anyam-p3-cohort-20260803-exports",
      "preview_bucket_name": "anyam-p3-cohort-20260803-exports-preview"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ANYAM_EVENTS",
        "queue": "anyam-p3-cohort-20260803-events"
      }
    ],
    "consumers": [
      {
        "queue": "anyam-p3-cohort-20260803-events"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "ANYAM_GITHUB_WEBHOOK_RATE_LIMITER",
      "namespace_id": "replace-with-customer-rate-limit-namespace-id",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "workflows": [
    {
      "binding": "ANYAM_WORKFLOW",
      "name": "anyam-p3-cohort-20260803-workflow",
      "class_name": "AnyamRealmWorkflow"
    }
  ]
}
